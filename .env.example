# Copy to .env (gitignored). Single-operator self-hosted runtime.

# Async runtime driver (asyncpg). App code uses this.
DATABASE_URL=postgresql://osiris:osiris@127.0.0.1:5432/osiris
REDIS_URL=redis://127.0.0.1:6379/0

# Single static operator identity — fills the actor/attribution role that
# Cloudflare Access would have provided. Every analyst-issued action is logged as this.
OSIRIS_ACTOR=analyst:operator

# Local object store for evidence artifacts (R2 replaced by filesystem on this box).
OSIRIS_ARTIFACT_DIR=./artifacts

# LLM fallback for classify() (Phase 2+). OAuth-vs-key TBD; leave blank for now.
# ANTHROPIC_API_KEY=
