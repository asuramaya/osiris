# Osiris developer-persona heartbeat (pulse) — systemd USER unit.
#
# The autonomic loop (src/orchestrator/pulse.py): every N seconds it senses which tracked
# repos' HEAD moved, re-ingests them, re-runs the deterministic lenses, and records the delta
# as FINDINGS in dev_pulses (read back via the `pulse-digest` lens). It NEVER mutates a repo —
# it reads and it tells (the brain + the alarm clock, never the hands). Restart=always means a
# crash (or a killed session) self-heals instead of leaving the heartbeat silently dead.
#
# Why a USER unit (not a system unit like deploy/osiris-{api,worker}.service): this runs AS the
# operator, against the operator's own dev instance and the repos in their home dir — no system
# account, no /opt deploy. The worker (deploy/osiris-worker.service) installs the same way for
# the single-operator dev box: copy it in, adjust User=/WorkingDirectory=/EnvironmentFile= to
# the inline user-level form below.
#
# Install (both units):
#   mkdir -p ~/.config/systemd/user
#   cp deploy/osiris-pulse.service ~/.config/systemd/user/
#   # author ~/.config/systemd/user/osiris-worker.service from deploy/osiris-worker.service,
#   # replacing User=/EnvironmentFile= with the inline Environment= + WorkingDirectory below and
#   # ExecStart=<venv>/bin/arq src.workers.arq_worker.WorkerSettings
#   systemctl --user daemon-reload
#   systemctl --user enable --now osiris-pulse osiris-worker
#   loginctl enable-linger "$USER"   # keep user units running after logout / across reboots
#                                    # (needs privilege; skip if unavailable — units still run
#                                    #  while you are logged in)
#
# Adjust WorkingDirectory / the venv path / the URLs / OSIRIS_DEV_REPOS to your box. systemd
# user units do NOT inherit your shell PATH, so ExecStart and the venv must be absolute.
[Unit]
Description=Osiris heartbeat (developer-persona pulse; read-only over local repos)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/code/osiris
# Point at the dev instance (PG :5601 / Redis :6396), inline so the repo's .env is untouched;
# systemd Environment= overrides pydantic's .env, which here only carries a non-DB key.
Environment=DATABASE_URL=postgresql://osiris:osiris@127.0.0.1:5601/osiris
Environment=REDIS_URL=redis://127.0.0.1:6396/0
# Repos the developer-pulse watches (read-only). Comma-separated absolute paths.
# Leave empty to watch nothing. Example: %h/code/osiris,%h/code/other
Environment=OSIRIS_DEV_REPOS=%h/code/osiris
# Sense HEAD every 600s. The digest/staleness verdict is computed on READ (the pulse-digest
# lens), so a dead loop is visible in the digest even if this unit stops (the dead-man's-switch).
ExecStart=%h/code/osiris/.venv/bin/python -m src.orchestrator.pulse --watch 600
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
