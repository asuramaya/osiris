# Osiris MCP server — systemd USER unit for the single-operator dev box.
#
# The persistent, always-on MCP server — the fleet floodgate. Under streamable-http this is
# ONE process the whole fleet of Claude instances connects to over HTTP, sharing a SINGLE
# database pool (bounded connections no matter how many agents tap in).
#
# A USER unit like deploy/user/osiris-console.service (runs AS the operator, against the
# operator's own dev instance — no /opt deploy, no system account), NOT the /opt system form
# of deploy/osiris-mcp.service. `osiris deploy` installs this file (thread e6fd3772 piece 3-
# infra) — it is no longer hand-authored or hand-copied.
[Unit]
Description=Osiris persistent MCP server (dev, streamable-http :8790)
After=network-online.target docker.service
Wants=network-online.target
# REBOOT SURVIVAL (thread 194eac83, operator ruling aaa8e841): disables systemd's own
# default 5-tries/10s start-limit so a slow-to-answer dependency after a cold boot never
# permanently strands a unit that would otherwise self-heal via Restart=always.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/code/osiris
# Point at the dev instance (PG :5601 / Redis :6396), inline so the repo's .env is untouched;
# systemd Environment= overrides pydantic's .env. application_name identifies this daemon's
# own connections in pg_stat_activity — asyncpg forwards any DSN query param it doesn't
# recognize straight into server_settings (connect_utils.py), so no code change was needed.
Environment=DATABASE_URL=postgresql://osiris:osiris@127.0.0.1:5601/osiris?application_name=osiris-mcp
Environment=REDIS_URL=redis://127.0.0.1:6396/0
Environment=OSIRIS_MCP_TRANSPORT=streamable-http
Environment=OSIRIS_MCP_HOST=127.0.0.1
Environment=OSIRIS_MCP_PORT=8790
# THE FREE OBSERVER'S ROOT (thread e332177f, operator's own box, 2026-09-14): this unit
# never carried OSIRIS_TRANSCRIPTS at all — osiris-worker's own OSIRIS_SENSE_SESSIONS
# below is a DIFFERENT, deliberately separate switch (settings.py's own docstring on
# osiris_transcripts: "KILLING THE EXPENSIVE INFERRER MUST NEVER BLIND THE FREE
# OBSERVER"), so setting one never implied the other. Every transcript-reading path that
# runs INSIDE this process (the provenance backfill's own transcript index, and the
# liveness transcript-mtime fallback whenever it's reached through an MCP door) was
# silently inert with settings.osiris_transcripts defaulting to "". Registered as
# `ingest.transcripts_root` in settings_registry.py (effect=restart:osiris-mcp) — an
# operator override there is substituted in here by render_units.py on the next deploy
# or boot-heal pass; this line is only the SHIPPED default.
Environment=OSIRIS_TRANSCRIPTS=%h/.claude/projects
# Soul-store encryption (Thoth mail 9134/9194/9245/9435, wave 17): this shape carries no
# EnvironmentFile= at all, so unlike the system-unit deploy (/etc/osiris/osiris.env) this
# var lives here, directly, in both this unit and osiris-worker.service. /etc/osiris is
# root-owned and unreachable from a --user unit regardless of any default this module
# assumes — %h/.config/osiris/soul.key is the operator's own, matching where
# `osiris soul-key-init` (run once, by hand, before either unit starts) actually writes.
Environment=OSIRIS_SOUL_KEY_FILE=%h/.config/osiris/soul.key
# The LLM provider is resolved with shutil.which('claude') at RUN time, and a user
# unit does not inherit a login shell's PATH — so the session-miner's provider was a
# coin flip on whatever PATH the user manager happened to carry. It lost silently for
# 10 hours on 2026-07-12 (48/48 ticks: 'no LLM provider for session-sensing'). Pinned.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# REBOOT SURVIVAL (thread 194eac83): After=docker.service orders unit start correctly, but
# docker's own container health lags its own systemd unit becoming active — this blocks
# activation until postgres actually answers on :5601 rather than racing it (/dev/tcp is a
# bash builtin, no extra binary dependency).
ExecStartPre=/bin/bash -c 'until (echo > /dev/tcp/127.0.0.1/5601) 2>/dev/null; do sleep 1; done'
ExecStart=%h/code/osiris/.venv/bin/python -m src.mcp_server
Restart=always
RestartSec=5
# Raised 1G -> 3G (2026-09-11, operator's ruling, WAVE 21 item 2, mail 9869) on both
# daemon tables (this unit and osiris-worker.service).
MemoryMax=3G
# #175 (2026-08-18): the 19:08:32 CDT system-wide OOM (an UNRELATED process, heinrich
# companion, at ~21.6GB RSS + a chrome renderer at 7.9GB, drove the box to 49G/61G used +
# 15G swap) took osiris-mcp and osiris-worker down alongside it — neither was the hog,
# but neither had any standing next to whatever else was on the box either. Matches
# deploy/user/osiris-manager.service's own precedent (OOMScoreAdjust=-900, "under system-wide
# memory pressure the kernel should reclaim from bodies long before it ever looks at the
# sacred proc") at a more moderate value: mcp is heavier and legitimately grows (a shared
# pool for the whole fleet), so -900's near-immunity would be the wrong trade if IT ever
# genuinely leaked — -500 ranks it below ordinary user processes without pretending it can
# never be the actual problem.
OOMScoreAdjust=-500

[Install]
WantedBy=default.target
