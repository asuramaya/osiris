# Weekly pg_basebackup — the physical starting point WAL replay needs for point-in-time
# recovery (vault lane, operator ruling 39384a87/c53a5fc0, item 3). Paired with
# osiris-base-backup.timer (Sun 02:00). The restore drill (Sun 05:30) verifies the fresh base and
# then applies the retention plan, so WAL is pruned back to a base that has been proven. DEPLOY-MANAGED
# (Thoth mail 8437, scripts/install_prune_timers.sh): every `osiris deploy` keeps this
# installed, current, and enabled without a hand — unlike osiris-manager.service
# beside it, which stays hand-install-only plumbing.
[Unit]
Description=Osiris weekly pg_basebackup into the vault

[Service]
Type=oneshot
ExecStart=%h/code/osiris/scripts/osiris_base_backup.sh
