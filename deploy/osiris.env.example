# /etc/osiris/osiris.env — shared by both units. The API and worker coordinate
# ONLY through these two backing services (no RPC mesh between them).
DATABASE_URL=postgresql://osiris:osiris@127.0.0.1:5432/osiris
REDIS_URL=redis://127.0.0.1:6379/0
OSIRIS_ACTOR=analyst:operator
OSIRIS_ARTIFACT_DIR=/var/lib/osiris/artifacts
# optional: the one keyed source (on-chain trace). Empty => it degrades gracefully.
ETHERSCAN_API_KEY=
# Soul-store encryption (Thoth mail 9134/9245, wave 17): the key file path is NOT a
# secret, only its CONTENTS are — naming it here means one config file, no new deploy
# step. NEITHER UNIT GENERATES THIS KEY — run `osiris soul-key-init` ONCE, by hand, as
# the osiris service user (or as root with --owner osiris), BEFORE starting either unit
# for the first time; it prints the MANDATORY offline recovery secret to stdout that
# ONE time — copy it to off-box custody immediately, it never prints again. Both units
# fail loudly at their own boot, naming this exact command, if no key is found — never
# a silent auto-generate inside a daemon. Losing both the key file and that offline
# copy makes every stored transcript permanently unreadable. Default if unset:
# /etc/osiris/soul.key (spelled out here only so the path is never a surprise).
# OSIRIS_SOUL_KEY_FILE=/etc/osiris/soul.key
# Session-sensing: the Claude Code projects root whose transcripts the worker senses
# (distill -> redact -> extract -> DERIVED backfill). Empty/unset => off.
# OSIRIS_SENSE_SESSIONS=/home/<operator>/.claude/projects
# The persistent MCP server (the fleet floodgate). streamable-http = one always-on server
# the whole fleet connects to, sharing ONE pool. Projects point .mcp.json at the URL.
OSIRIS_MCP_TRANSPORT=streamable-http
OSIRIS_MCP_HOST=127.0.0.1
OSIRIS_MCP_PORT=8790
