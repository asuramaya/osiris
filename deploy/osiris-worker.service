# Osiris worker (the cascade drain + the watch + the reaper). Fate-isolated from the
# API: a runaway crawl, an OOM, or a crash here cannot take down the console. On
# restart it re-claims orphaned runs (the reaper) and resumes draining the durable
# outbox — no work is lost, nothing double-emits (atomic helper_runs claim).
# See docs/DEPLOY.md.
[Unit]
Description=Osiris worker (Arq: cascade, watch, reaper)
After=network-online.target postgresql.service redis.service
Wants=network-online.target

[Service]
Type=simple
User=osiris
WorkingDirectory=/opt/osiris
EnvironmentFile=/etc/osiris/osiris.env
# THE ONE REAL WORKER (decision 8a830336): the boot-time deploy-guard checks in
# arq_worker.startup() only run when this is set — an ad hoc/local/test `arq` invocation
# leaves it unset and stays silent, never confessing a spurious "UNREVIEWED BOOT" against
# the shared graph. Inline here (not in the EnvironmentFile) so it can never be dropped by
# an unrelated edit to the shared env file, same reasoning as PATH below in the dev unit.
Environment=OSIRIS_WORKER_ROLE=primary
ExecStart=/opt/osiris/.venv/bin/arq src.workers.arq_worker.WorkerSettings
Restart=always
RestartSec=2
# a runaway expansion is contained here, not in the API. Tune to the box.
MemoryMax=4G

[Install]
WantedBy=multi-user.target
